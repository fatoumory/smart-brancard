# Variables lues par docker compose (à la racine du projet)
# Copier ce fichier en .env seulement pour changer une valeur par défaut.
# Lancement manuel (sans Docker pour le backend) : les variables du backend vont dans backend/.env
# (voir backend/.env.example). Avec docker compose up, ce sont celles de ce fichier.

# Identifiants de la base PostGIS
# Attention : POSTGRES_DB n'est appliqué qu'à la première création du volume Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_brancard_db

# Ports sur la machine : à changer si un autre logiciel occupe déjà l'un d'eux
# (pour PostgreSQL, adapter aussi le port dans DATABASE_URL de backend/.env)
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=8088
FRONTEND_PORT_HTTPS=8443

# Clé de signature des connexions. Vide : clé temporaire à chaque démarrage (il faut se reconnecter
# après un redémarrage). Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 : comptes, équipe et patients de démonstration (mot de passe connu de tous). 0 hors démonstration
DEMO=1

# Réglages de l'hôpital (voir backend/.env.example)
MIN_AGENTS_DISPONIBLES=1
SEUIL_SATURATION=3
# Processus de l'API (le temps réel passe par Redis entre eux)
WORKERS=2
