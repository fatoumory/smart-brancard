# Variables lues par docker compose (à la racine du projet)
# Copier ce fichier en .env seulement pour changer une valeur par défaut.
# Les variables du backend (DATABASE_URL, SECRET_KEY...) vont dans backend/.env (voir backend/.env.example)

# Identifiants de la base PostGIS
# Attention : POSTGRES_DB n'est appliqué qu'à la première création du volume Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_brancard_db

# Port de PostgreSQL sur la machine : mettre 5433 si un PostgreSQL local occupe déjà le 5432
# (et adapter le port dans DATABASE_URL de backend/.env)
POSTGRES_PORT=5432
