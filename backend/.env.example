# Copier ce fichier en .env et adapter les valeurs
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_brancard_db
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a_remplacer
# Origines autorisées pour le frontend (séparées par des virgules)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Nombre minimum de brancardiers qui doivent rester disponibles : une pause qui ferait
# descendre en dessous est refusée (0 = pas de limite)
MIN_AGENTS_DISPONIBLES=1
