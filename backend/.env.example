# Copier ce fichier en .env et adapter les valeurs
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_brancard
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a_remplacer
# Origines autorisées pour le frontend (séparées par des virgules)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
